// Mekanisme Watch/Unwatch File untuk Reload (Kode Verifikasi Tersembunyi)
let file = fileURLToPath(import.meta.url)
watchFile(file, () => {
  unwatchFile(file)
  console.log(chalk.redBright("Pembaruan 'config.js'"))
  import(`${file}?update=${Date.now()}`)
})