    "120363423328798929@g.us": {
      "listStr": {
        "p": {
          "key": {
            "remoteJid": "120363423328798929@g.us",
            "fromMe": false,
            "id": "A5BD694F8217F65C7F6571AB8AF63E75",
            "participant": "62881026908371@s.whatsapp.net"
          },
          "message": {
            "conversation": "import fs from 'fs';\nimport axios from 'axios';\n// Import fungsi resolveWid dari lib/jid.js\nimport { resolveWid } from '../lib/jid.js'; \n\n// Fungsi untuk mengkonversi milidetik ke format Durasi yang mudah dibaca\nfunction formatDuration(ms) {\n    const seconds = Math.floor((ms / 1000) % 60);\n    const minutes = Math.floor((ms / (1000 * 60)) % 60);\n    const hours = Math.floor((ms / (1000 * 60 * 60)) % 24);\n    const days = Math.floor(ms / (1000 * 60 * 60 * 24));\n    \n    let parts = [];\n    if (days > 0) parts.push(`${days} hari`);\n    if (hours > 0) parts.push(`${hours} jam`);\n    if (minutes > 0) parts.push(`${minutes} menit`);\n    if (seconds > 0 && parts.length < 2) parts.push(`${seconds} detik`);\n\n    return parts.length > 0 ? parts.join(', ') : 'Baru saja dimulai!';\n}\n\n// Fungsi untuk membersihkan JID dari karakter tidak terlihat (Zero-Width Characters) sebelum ditampilkan\nconst cleanJidDisplay = (jid) => {\n    if (!jid) return '';\n    // Regex untuk menghapus karakter ZWSP, ZWNJ, ZWJ, RLM, LRM, dan karakter kontrol serupa\n    return jid.replace(/[\\u200B-\\u200D\\u202A-\\u202E\\uFEFF]/g, '').split('@')[0];\n};\n\nconst handler = async (m, { conn }) => {\n    // TENTUKAN NAMA BOT SECARA EKSPLISIT\n    const botName = \"Araa bot\";\n\n    // Pastikan database users ada\n    global.db.data.users = global.db.data.users || {};\n\n    let rawTarget; // JID sebelum di-resolve\n\n    // --- LOGIKA PENENTUAN RAW TARGET ---\n    if (m.mentionedJid && m.mentionedJid.length > 0) {\n        rawTarget = m.mentionedJid[0];\n    } else if (m.quoted && m.quoted.sender) {\n        rawTarget = m.quoted.sender;\n    } else {\n        rawTarget = m.sender;\n    }\n    // ------------------------------------\n    \n    // --- RESOLVE TARGET JID MENGGUNAKAN lib/jid.js ---\n    let target = rawTarget;\n    try {\n        const resolved = await resolveWid(m, conn, rawTarget);\n        if (resolved) {\n            target = resolved;\n        }\n    } catch (e) {\n        console.error('Error resolving JID:', e);\n    }\n    // -------------------------------------------------\n\n    // Kontak placeholder untuk quoted\n    const fkontak = {\n        \"key\": {\n            \"participant\": '0@s.whatsapp.net',\n            \"remoteJid\": \"0@s.whatsapp.net\",\n            \"fromMe\": false,\n            \"id\": \"Halo\",\n        },\n        \"message\": {\n            \"conversation\": `✨ Profil Pengguna ${botName} ✨`,\n        }\n    };\n\n    // Pastikan data pengguna target ada di database\n    if (!global.db.data.users[target]) {\n        global.db.data.users[target] = {};\n    }\n    let user = global.db.data.users[target];\n\n    // Ambil nama pengguna target dari WhatsApp jika belum ada\n    const targetName = (await conn.getName(target)) || \"Pengguna Cantik\";\n\n    // Inisialisasi properti user\n    user.name = user.name || targetName;\n    user.umur = user.umur || \"-\";\n    user.ttl = user.ttl || \"-\";\n    user.foto = user.foto || null;\n    user.jk = user.jk || \"-\";\n    user.agama = user.agama || \"-\";\n    user.hobi = user.hobi || \"-\";\n    user.kota = user.kota || \"-\";\n    user.negara = user.negara || \"-\";\n    user.level = user.level || 1;\n    user.money = user.money || 0;\n    user.bank = user.bank || 0;\n    user.exp = user.exp || 0;\n    user.premium = user.premium || false;\n    user.limit = user.limit || 10;\n    user.partner = user.partner || null; // Pacar JID\n    user.dateJoined = user.dateJoined || null; // Timestamp jadian\n    user.pernikahan = user.pernikahan || \"Belum Menikah\"; // TIDAK DIGUNAKAN, tapi dibiarkan untuk data\n    user.jumlahAnak = user.jumlahAnak || 0; // TIDAK DIGUNAKAN\n    user.pasangan = user.pasangan || null; // TIDAK DIGUNAKAN\n    user.anak = user.anak || []; // TIDAK DIGUNAKAN\n\n    let {\n        name, umur, ttl, foto, jk, agama, hobi, kota, negara,\n        level, money, bank, exp, premium, \n        channel, facebook, instagram, tiktok\n    } = user;\n    let limit = premium ? \"♾️ Unlimited\" : user.limit;\n\n    // --- LOGIKA STATUS PACARAN ---\n    let statusPacaran = \"Jomblo 💔\";\n    let detailHubungan = \"\";\n    \n    if (user.partner && user.dateJoined) {\n        const partnerJid = user.partner;\n        let partnerName;\n        try {\n            // Menggunakan cleanJidDisplay untuk membersihkan nama\n            partnerName = (await conn.getName(partnerJid)) || cleanJidDisplay(partnerJid);\n        } catch {\n            partnerName = \"Partner Tidak Dikenal\";\n        }\n        \n        const now = Date.now();\n        const durationMs = now - user.dateJoined;\n        const durationFormatted = formatDuration(durationMs);\n        const date = new Date(user.dateJoined);\n        const dateOptions = { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Jakarta' };\n        const dateFormatted = date.toLocaleDateString('id-ID', dateOptions);\n\n        statusPacaran = `Pacaran ❤️`;\n        detailHubungan = `\n*• Pasangan:* ${partnerName} (@${cleanJidDisplay(partnerJid)}) \n*• Jadian:* ${dateFormatted}\n*• Durasi:* ${durationFormatted}\n`;\n    }\n    // ----------------------------\n\n    let mode = global.opts?.self ? \"🔒 Self\" : \"🌍 Public\";\n\n    // Hitung Uptime Bot\n    let uptimeSeconds = process.uptime();\n    let hari = Math.floor(uptimeSeconds / (3600 * 24));\n    uptimeSeconds %= (3600 * 24);\n    let jam = Math.floor(uptimeSeconds / 3600);\n    uptimeSeconds %= 3600;\n    let menit = Math.floor(uptimeSeconds / 60);\n    let detik = Math.floor(uptimeSeconds % 60);\n    let uptimeText = `${hari} hari, ${jam} jam, ${menit} menit, ${detik} detik`;\n\n    // Ambil Waktu dan Tanggal Lokal\n    let d = new Date();\n    let date = d.toLocaleDateString(\"id-ID\", {\n        weekday: \"long\", year: \"numeric\", month: \"long\", day: \"numeric\"\n    });\n    let time = d.toLocaleTimeString(\"id-ID\");\n\n    // Ambil URL Foto Profil\n    let thumbnailUrl;\n    try {\n        if (foto && foto.startsWith('http')) {\n            thumbnailUrl = foto;\n        } else {\n            let ppUrl = await conn.profilePictureUrl(target, 'image').catch(() => null);\n            thumbnailUrl = ppUrl || 'https://telegra.ph/file/ee60957d56941b8fdd221.jpg'; // Fallback image\n        }\n    } catch (e) {\n        console.error('Error fetching profile image, using fallback:', e);\n        thumbnailUrl = 'https://telegra.ph/file/ee60957d56941b8fdd221.jpg'; // Fallback image\n    }\n\n    // --- Detail informasi profil untuk caption utama ---\n    let mainCaption = `\n✨ *PROFIL PENGGUNA* ✨\n----------------------------------------\n📝 *Nama:* ${name}\n🎂 *Umur:* ${umur}\n📅 *Tanggal Lahir:* ${ttl}\n⚧️ *Jenis Kelamin:* ${jk}\n🛐 *Agama:* ${agama}\n🎨 *Hobi:* ${hobi}\n🌆 *Kota:* ${kota}\n🌍 *Negara:* ${negara}\n\n----------------------------------------\n⭐ *Level:* ${level}\n🎯 *Limit:* ${limit}\n💸 *Saldo:* Rp ${money.toLocaleString('id-ID')}\n🏦 *Bank:* Rp ${bank.toLocaleString('id-ID')}\n⚡ *Exp:* ${exp}\n🎫 *Premium:* ${premium ? '✅ Ya' : '❌ Tidak'}\n\n---\n❤️ *STATUS HUBUNGAN* ❤️\n----------------------------------------\n*Status Pacaran:* ${statusPacaran}\n${detailHubungan}\n\n----------------------------------------\n📺 *Channel:* ${channel}\n📱 *Facebook:* ${facebook}\n📸 *Instagram:* ${instagram}\n🎵 *TikTok:* ${tiktok}\n\n✨ *INFO BOT & WAKTU* ✨\n----------------------------------------\n🤖 *Nama Bot:* Araa bot\n🛠️ *Mode:* ${mode}\n⏱️ *Uptime:* ${uptimeText}\n🗓️ *Tanggal:* ${date}\n⏰ *Waktu:* ${time} WIB\n\n> © Araa bot 2025 🌷\n    `.trim();\n    // --- Akhir detail informasi profil untuk caption utama ---\n\n    // Opsi tombol interaktif\n    const profileOptions = [\n        { header: '✏️ Edit Profilku', title: 'Ubah informasi pribadi Anda', description: 'Nama, umur, hobi, dll.', id: '.editprofile' },\n        { header: '💰 Cek Saldo', title: 'Lihat jumlah uang Anda', description: 'Saldo uang dan bank', id: '.bank' },\n        { header: '📈 Lihat Statistik', title: 'Lihat level, EXP, dan limit Anda', description: 'Progres dan batasan akun', id: '.inv' },\n        { header: 'ℹ️ Info Bot', title: 'Informasi umum tentang bot', description: 'Uptime, mode, dll.', id: '.sc' }\n    ];\n\n    let interactiveButtons = [\n        {\n            name: 'single_select',\n            buttonParamsJson: JSON.stringify({\n                title: 'Pilih Opsi Profil',\n                sections: [ { title: 'Tindakan Profil', highlight_label: 'Pilih Salah Satu', rows: profileOptions } ]\n            })\n        },\n        {\n            name: 'cta_url',\n            buttonParamsJson: JSON.stringify({\n                display_text: '👤 Owner',\n                url: 'https://wa.me/6281399172380', \n                merchant_url: 'https://wa.me/6281399172380'\n            })\n        }\n    ];\n\n    await conn.sendMessage(m.chat, { react: { text: '👤', key: m.key } });\n\n    await conn.sendMessage(m.chat, {\n        product: {\n            productImage: { url: thumbnailUrl },\n            productId: '9999999999999999',\n            title: `Profil ${name}`,\n            description: `Level ${level} | Limit ${limit}`,\n            currencyCode: 'IDR',\n            priceAmount1000: '0',\n            retailerId: 'user-profile',\n            url: 'https://wa.me/' + cleanJidDisplay(target),\n            productImageCount: 1\n        },\n        businessOwnerJid: '6281399172380@s.whatsapp.net', // Ganti dengan nomor owner Anda\n        caption: mainCaption,\n        title: `Informasi Akun ${name}`,\n        subtitle: `ID: ${cleanJidDisplay(target)}`,\n        footer: `> $ Araa bot | ${date}`,\n        interactiveButtons: interactiveButtons,\n        hasMediaAttachment: false\n    }, { quoted: fkontak });\n\n    await conn.sendMessage(m.chat, { react: { text: '✅', key: m.key } });\n};\n\nhandler.command = [\"profile\", \"me\", \"saya\"];\nhandler.help = [\"profile [@tag]\", \"me [@tag]\", \"saya [@tag]\"];\nhandler.tags = [\"main\"];\nhandler.register = true;\n\nexport default handler;"
          },
          "messageTimestamp": "1775682525",
          "broadcast": false,
          "pushName": "Fariel"
        }
      },
